# EF5 CUSTOM SOURCE INJECTION CONFIGURATION (OPTION 3)\
# =====================================================================\
# Usage and Instructions:\
# To use this file, copy this file to the main directory \'93EF5-dockerized\'94\
# and save it as \'93custom_sources.env\'94. Uncomment and modify the\
# variables below to inject a custom EF5 repository into the Docker\
# build process. If this file exists and variables are active, the\
# build_ef5_container script will use them as the default "Option 3".\
# =====================================================================\
\
# ---------------------------------------------------------------------\
# 1. CORE COMPILATION REQUIREMENTS (READ BEFORE MODIFYING)\
# ---------------------------------------------------------------------\
# To successfully build within this containerized workflow, your custom\
# fork or branch MUST support the traditional C/C++ automake sequence \
# originally established by the HyDROSLab codebase[cite: 3]:\
#   1. autoreconf --force --install\
#   2. ./configure\
#   3. make\
#\
# If your fork strictly requires proprietary build scripts (e.g., custom\
# CMake setups or shell scripts) without supporting autoreconf, the \
# standard Dockerfile build will fail[cite: 1, 3].\
# ---------------------------------------------------------------------\
\
# ---------------------------------------------------------------------\
# 2. REPOSITORY URL (EF5_REPO_URL)\
# ---------------------------------------------------------------------\
# Specify the Git URL to your EF5 repository.\
#\
# PUBLIC REPOSITORY EXAMPLE:\
# EF5_REPO_URL="https://github.com/YourOrg/EF5.git"\
#\
# PRIVATE REPOSITORY EXAMPLE (Using GitHub Personal Access Token):\
# WARNING: Do not commit this file to version control if using a PAT!\
# EF5_REPO_URL="https://<YOUR_GITHUB_PAT>@github.com/YourOrg/EF5-private.git"\
\
EF5_REPO_URL="https://github.com/YourOrg/EF5.git"\
\
# ---------------------------------------------------------------------\
# 3. BRANCH OR TAG (EF5_BRANCH)\
# ---------------------------------------------------------------------\
# Specify the exact branch name, release tag, or commit hash to clone.\
#\
# BRANCH EXAMPLE:\
# EF5_BRANCH="development-branch"\
#\
# TAG EXAMPLE (e.g., the AHWALab v1.2.7 release)[cite: 1]:\
# EF5_BRANCH="v1.2.7"\
\
EF5_BRANCH="master"\
\
# ---------------------------------------------------------------------\
# 4. OS / COMPILER TOOLCHAIN (ALPINE_VERSION)\
# ---------------------------------------------------------------------\
# The default build uses Alpine Linux 3.17 to maintain compatibility \
# with older C++ codebases[cite: 2]. If your active development branch \
# requires a newer gcc/g++ toolchain, or an older one throws warnings, \
# you can override the base OS version here.\
#\
# NEWER TOOLCHAIN EXAMPLE:\
# ALPINE_VERSION="3.19"\
#\
# OLDER TOOLCHAIN EXAMPLE:\
# ALPINE_VERSION="3.15"\
\
ALPINE_VERSION="3.17"}